(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the ketchup in the basket and put the orange juice in the basket)
    (:regions
      (basket_init_region
          (:target study_table)
          (:ranges (
              (-0.19999999999999998 -0.3 0.15 0.3)
            )
          )
          (:yaw_rotation (
              (0 6.283185307179586)
            )
          )
      )
      (alphabet_soup_init_region
          (:target study_table)
          (:ranges (
              (-0.19999999999999998 -0.3 0.15 0.3)
            )
          )
          (:yaw_rotation (
              (0 6.283185307179586)
            )
          )
      )
      (tomato_sauce_init_region
          (:target study_table)
          (:ranges (
              (-0.19999999999999998 -0.3 0.15 0.3)
            )
          )
          (:yaw_rotation (
              (0 6.283185307179586)
            )
          )
      )
      (milk_init_region
          (:target study_table)
          (:ranges (
              (-0.19999999999999998 -0.3 0.15 0.3)
            )
          )
          (:yaw_rotation (
              (0 6.283185307179586)
            )
          )
      )
      (cream_cheese_init_region
          (:target study_table)
          (:ranges (
              (-0.19999999999999998 -0.3 0.15 0.3)
            )
          )
          (:yaw_rotation (
              (0 6.283185307179586)
            )
          )
      )
      (orange_juice_init_region
          (:target study_table)
          (:ranges (
              (-0.19999999999999998 -0.3 0.15 0.3)
            )
          )
          (:yaw_rotation (
              (0 6.283185307179586)
            )
          )
      )
      (butter_init_region
          (:target study_table)
          (:ranges (
              (-0.19999999999999998 -0.3 0.15 0.3)
            )
          )
          (:yaw_rotation (
              (0 6.283185307179586)
            )
          )
      )
      (ketchup_init_region
          (:target study_table)
          (:ranges (
              (-0.19999999999999998 -0.3 0.15 0.3)
            )
          )
          (:yaw_rotation (
              (0 6.283185307179586)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    study_table - study_table
  )

  (:objects
    basket_1 - basket
    alphabet_soup_1 - alphabet_soup
    tomato_sauce_1 - tomato_sauce
    milk_1 - milk
    cream_cheese_1 - cream_cheese
    orange_juice_1 - orange_juice
    butter_1 - butter
    ketchup_1 - ketchup
  )

  (:obj_of_interest
    ketchup_1
    orange_juice_1
  )

  (:init
    (On basket_1 study_table_basket_init_region)
    (On alphabet_soup_1 study_table_alphabet_soup_init_region)
    (On tomato_sauce_1 study_table_tomato_sauce_init_region)
    (On milk_1 study_table_milk_init_region)
    (On cream_cheese_1 study_table_cream_cheese_init_region)
    (On orange_juice_1 study_table_orange_juice_init_region)
    (On butter_1 study_table_butter_init_region)
    (On ketchup_1 study_table_ketchup_init_region)
  )

  (:goal
    (And (In ketchup_1 basket_1_contain_region) (In orange_juice_1 basket_1_contain_region))
  )


  (:subtask_rewards
    (:subtask place_ketchup_1
      (:predicate (In ketchup_1 basket_1_contain_region))
      (:reward 1.0)
    )
    (:subtask place_orange_juice_1
      (:predicate (In orange_juice_1 basket_1_contain_region))
      (:reward 1.0)
    )
  )

)
